# ---- Django ----
# حتماً یک مقدار تصادفی بلند بگذارید: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
TZ=Asia/Tehran

# پورتی که پنل روی آن باز می‌شود و آدرس عمومی (برای لینک‌های دانلود در latest.json)
HTTP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# ---- PostgreSQL ----
POSTGRES_DB=asandesk
POSTGRES_USER=asandesk
POSTGRES_PASSWORD=change-me

# ---- مالک اولیه (فقط بار اول ساخته می‌شود) ----
OWNER_USERNAME=owner
OWNER_PASSWORD=change-me-please

# ---- agent مانیتورینگ همین سرور ----
# توکن مشترک بین backend و agent: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=change-me-agent-token
LOCAL_SERVER_NAME=dashboard-local
LOCAL_SERVER_REGION=محلی
# فقط اتصال‌های این پورت‌ها شمرده شود (خالی = همه اتصال‌های TCP برقرار). برای آسان‌دسک: 21116,21117
AGENT_PORTS=
# ظرفیت لینک شبکه به مگابیت (خالی = تشخیص خودکار، در غیر این صورت ۱۰۰۰)
AGENT_NET_CAPACITY_MBPS=
# IP نمایش‌داده‌شده برای این سرور (اختیاری)
AGENT_IP=

# حداکثر حجم هر فایل نصب (مگابایت)
RELEASE_MAX_FILE_MB=500
