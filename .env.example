# فقط اطلاعات دیتابیس. بقیه رازها (کلید Django) خودکار ساخته می‌شوند
# و حساب مالک در اولین ورود از طریق مرورگر ساخته می‌شود.
POSTGRES_USER=asandesk
# رمز فقط در اولین اجرا روی دیتابیس اعمال می‌شود. بعد از آن عوض کردنش در این فایل
# خطای «password authentication failed» می‌دهد؛ رفعش: sh scripts/sync-db-password.sh
POSTGRES_PASSWORD=change-me

# اختیاری: پروکسی HTTP سرور برای دانلود پکیج‌ها هنگام بیلد (npm از SOCKS پشتیبانی نمی‌کند)
# BUILD_PROXY=http://127.0.0.1:10809

# اختیاری: پروکسی HTTP برای گرفتن نسخهٔ جدید پنل از GitHub (تنظیمات ← به‌روزرسانی پنل).
# اگر خالی باشد همان BUILD_PROXY استفاده می‌شود؛ اگر سرور مستقیم به GitHub می‌رسد هیچ‌کدام لازم نیست.
# GIT_PROXY=http://127.0.0.1:10809

# اختیاری: آدرس مخفی پنل (مثل x-ui). ۱۲ تا ۶۴ نویسه از حروف انگلیسی، عدد، - و _
# با این مقدار، پنل فقط بعد از باز کردن https://<دامنه‌ی پنل>/<این مقدار> یک بار در هر مرورگر باز می‌شود.
# ساخت یک مقدار تصادفی:  head -c 18 /dev/urandom | base64 | tr '+/' '-_' | tr -d '='
# PANEL_KEY=

# پشت CDN (مثل آروان‌کلود): فهرست شبکه‌های آن در nginx/cdn-ips.conf است تا nginx آدرس واقعی کاربر را بخواند
# (محدودیت نرخ و ورود به‌ازای هر کاربر کار کند). به‌روزرسانی فهرست: sh scripts/update-cdn-ips.sh
# وقتی پنل را همیشه با https باز می‌کنید (CDN با گواهی)، این را روشن کنید تا کوکی نشست فقط روی https برود:
# SECURE_COOKIES=1

# اختیاری: ظرفیت و سقف‌ها (پیش‌فرض‌ها در docker-compose.yml)
# WEB_CONCURRENCY=4                    # تعداد پردازهٔ وب؛ حدوداً دو برابر هستهٔ CPU
# GUNICORN_THREADS=4                   # نخ در هر پردازه
# CLIENT_NEW_DEVICES_PER_IP_HOUR=100   # دستگاه تازه در ساعت از یک آدرس
# CLIENT_FEEDBACK_PER_IP_HOUR=30       # بازخورد در ساعت از یک آدرس
# FEEDBACK_MAX_TOTAL_MB=2048           # سقف کل فضای لاگ و تصویر بازخوردها (بعد از آن فقط متن ذخیره می‌شود)

# آسان دسک وب (docs/ASANDESK-WEB.md). همه اختیاری‌اند؛ پیش‌فرض‌ها برای وقتی است که hbbs و hbbr روی همین سرورند.
# HBBS_LAN_IP=192.168.1.10                 # اگر داشبورد و hbbs در یک شبکهٔ داخلی‌اند و از داشبورد به rd.asandesk.ir نمی‌رسد: آی‌پی داخلی hbbs
# HBBR_LAN_IP=192.168.1.11                 # آی‌پی داخلی hbbr، فقط اگر جدا از hbbs است (پیش‌فرض: HBBS_LAN_IP)
# WEB_RELAY_LAN=relay2.asandesk.ir=192.168.1.12   # رله‌های دیگر در شبکهٔ داخلی، با کاما جدا
# WEBGW_HBBS_HOST=rd.asandesk.ir           # سرور شناسه‌ای که کد کاربر وب در آن ثبت می‌شود (همان که برنامهٔ دسکتاپ می‌پرسد)
# WEBGW_HBBS_HOST=hbbs-host                # فقط اگر hbbs روی همین میزبان است و نام عمومی از داخل داکر نمی‌رسد (HBBS_IP خالی = میزبان)
# WEBGW_RELAY_SERVER=rd.asandesk.ir        # رله‌ای که به کارشناس معرفی می‌شود (زیر asandesk.ir، درگاه وب‌سوکت 21119)
# WEB_RS_PUBLIC_KEY=                       # کلید عمومی hbbs (پیش‌فرض: همان کلید داخل برنامه)
# WEB_RELAY_WS_MAP=relay2.asandesk.ir=wss://relay2.asandesk.ir/ws/relay   # فقط اگر چند رله دارید
# WEB_DOWNLOAD_URL=https://asandesk.ir/download
